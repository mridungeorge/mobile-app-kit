# Fastlane template for native iOS (Swift/SwiftUI) releases.
# Run with `bundle exec fastlane <lane>` from the folder that contains fastlane/.
# Lanes: test, beta (TestFlight), release (App Store). Nothing here is submitted
# for review: `release` uploads the build and metadata and stops. A human presses
# "Submit for Review" (or flips submit_for_review once you trust the pipeline).
#
# Config comes from env vars so the same file works locally and in CI:
#   IOS_PROJECT      path to the .xcodeproj      (default ios/App.xcodeproj)
#   IOS_SCHEME       Xcode scheme                (default App)
#   IOS_TEST_DEVICE  simulator name for `test`   (default iPhone 16)
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY   App Store Connect API key (.p8 text)
#   MATCH_GIT_URL, MATCH_PASSWORD        only when SIGNING=match

default_platform(:ios)

PROJECT = ENV.fetch("IOS_PROJECT", "ios/App.xcodeproj")
SCHEME  = ENV.fetch("IOS_SCHEME", "App")

platform :ios do
  before_all do
    # On CI this creates a throwaway keychain and makes match read-only.
    setup_ci if is_ci
  end

  desc "Run unit tests on a simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("IOS_TEST_DEVICE", "iPhone 16")
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    asc_api_key
    sign_app
    build_number = latest_testflight_build_number(api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)
    build_app(project: PROJECT, scheme: SCHEME, export_method: "app-store")
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true
    )
  end

  desc "Check metadata, build, and upload to App Store Connect (does not submit)"
  lane :release do
    asc_api_key
    sign_app
    # Fails the lane on placeholder text, broken URLs and similar review rejections.
    precheck(api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
    build_number = latest_testflight_build_number(api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)
    build_app(project: PROJECT, scheme: SCHEME, export_method: "app-store")
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      submit_for_review: false,
      automatic_release: false,
      force: true # skip the interactive HTML preview, required on CI
    )
  end

  desc "Check store metadata only, with no build or upload"
  lane :check_metadata do
    asc_api_key
    precheck(api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY") # contents of the .p8 file
    )
  end

  # SIGNING=match uses fastlane match (certs in a private encrypted repo).
  # Otherwise the project's automatic signing is used, which is fine for one dev.
  private_lane :sign_app do
    if ENV["SIGNING"] == "match"
      match(
        type: "appstore",
        readonly: is_ci,
        api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
      )
    end
  end
end
