# Fastlane template for native iOS (Swift/SwiftUI) production releases.
# Install: gem install fastlane (or Bundler). Run from ios project root (where .xcodeproj/.xcworkspace lives).

default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    run_tests(
      scheme: ENV.fetch("IOS_SCHEME", "App"),
      device: "iPhone 15"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Requires App Store Connect API key configured (recommended) or Apple ID auth.
    # Ensure signing (match/manual/automatic) is configured for CI.
    increment_build_number(xcodeproj: ENV.fetch("IOS_PROJECT", "App.xcodeproj"))
    build_app(
      scheme: ENV.fetch("IOS_SCHEME", "App"),
      export_method: "app-store"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and submit to App Store"
  lane :release do
    increment_build_number(xcodeproj: ENV.fetch("IOS_PROJECT", "App.xcodeproj"))
    build_app(
      scheme: ENV.fetch("IOS_SCHEME", "App"),
      export_method: "app-store"
    )
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false
    )
  end
end
