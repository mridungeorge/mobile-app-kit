{
  "expo": {
    "name": "HabitLoop",
    "slug": "habitloop",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.habitloop",
      "infoPlist": {
        "NSCameraUsageDescription": "Attach a photo to a habit entry.",
        "NSUserTrackingUsageDescription": "Measure which onboarding screen leads to a subscription."
      }
    },
    "android": {
      "package": "com.example.habitloop",
      "permissions": ["android.permission.POST_NOTIFICATIONS", "android.permission.CAMERA"]
    },
    "plugins": ["expo-notifications"]
  }
}
