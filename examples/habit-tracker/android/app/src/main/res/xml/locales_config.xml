<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language (Android 13+). Add a locale here and ship the matching res/values-<locale>
     strings; Android then offers it in Settings → System → Languages → App languages. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
</locale-config>
