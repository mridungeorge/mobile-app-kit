# Normalise line endings so the same repo behaves the same on macOS, Linux and Windows.
# Text files are stored with LF in the index and checked out with LF everywhere.
* text=auto eol=lf

# Shell scripts must never carry CRLF: a CRLF shebang breaks on Linux/macOS and in CI.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.pro text eol=lf
*.xml text eol=lf

# Windows-only entry points keep CRLF so cmd.exe parses them correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper entry points. `gradlew` has no extension, so it needs its own rule;
# a CRLF shebang makes it fail on Linux, macOS and every CI runner.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binaries: never diff, never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.woff2 binary
*.ttf binary
*.jar binary
*.keystore binary
*.jks binary
*.p8 binary
*.p12 binary
